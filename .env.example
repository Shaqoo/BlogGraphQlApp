# BlogApp environment template
# Copy to `.env`, fill in real values, and keep `.env` out of version control.
#   cp .env.example .env
# The file is read by `dotnet run` (Program.cs loads it via DotNetEnv) and by
# `docker compose up` (env_file). Values here override appsettings.json.

# ASP.NET Core
# Development = local storage (wwwroot). Production = UploadThing.
ASPNETCORE_ENVIRONMENT=Development

# Database (MySQL) - used by the app when run directly (dotnet run / localhost).
# In docker-compose this is overridden to point at the `db` service.
# Single quotes preserve literal "$" characters.
ConnectionStrings__DefaultConnection='server=localhost;port=3306;database=blogapp_gql;user=root;password=change_me;'

# JWT - use a long random string in production
Jwt__Issuer=Reelio-Blog-issuer
Jwt__Audience=Reelio-Blog-audience
Jwt__Key=change_me_to_a_long_random_secret

# Email (SMTP) - e.g. Gmail app password
EmailSettings__SmtpServer=smtp.gmail.com
EmailSettings__Port=587
EmailSettings__SenderName=Reelio
EmailSettings__SenderEmail=you@gmail.com
EmailSettings__Password=change_me

# Spotify
SpotifySettings__ClientId=change_me
SpotifySettings__ClientSecret=change_me

# Gemini
GeminiSettings__ApiKey=change_me

# OpenAI
OpenAI__ApiKey=change_me

# UploadThing - the Secret (sk_live_...) authenticates API requests (x-uploadthing-api-key).
# AppId is public and appears in file URLs. Token is an optional base64 alias for the Secret.
UploadThing__Secret=sk_live_xxxxx
UploadThing__Token=
UploadThing__AppId=your_app_id

# Pinecone
Pinecone__ApiKey=change_me
Pinecone__Environment=us-east-1
Pinecone__IndexName=content-embeddings
Pinecone__ProjectName=change_me
Pinecone__Host=https://your-index.svc.pinecone.io

# Agora (optional)
Agora__AppId=
Agora__AppCertificate=

# MySQL container credentials (read by docker-compose for the db service).
# Avoid "$" in the password.
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=blogapp_gql
