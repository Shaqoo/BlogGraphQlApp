    <PackageReference Include="Pinecone.NET" Version="3.0.0" />
    <PackageReference Include="Polly" Version="8.6.5" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.0" />
    <PackageReference Include="Scrypt.NET" Version="1.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Primitives" Version="4.3.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="Xabe.FFmpeg" Version="6.0.2" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
  </ItemGroup>
  <Target Name="ExcludeConflictingNativeLibrariesFromPublish"
          AfterTargets="ComputeFilesToPublish"
          BeforeTargets="_HandleFileConflictsForPublish">
    <!-- Native packages (agora_rtc_sdk, Accord.Video.FFMPEG(.x64)) ship x86/x64
         binaries with flat Link names, so `dotnet publish` fails with NETSDK1152
         (duplicate publish output paths). These DLLs are not loaded by this app
         (Agora token generation is stubbed; the ffmpeg video pipeline uses the
         system ffmpeg binary via Xabe.FFmpeg), so exclude them from publish.
         `dotnet run`/build (which copies them to bin/) is unaffected. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(ResolvedFileToPublish.SourcePath)').Contains('\agora_rtc_sdk\')) or $([System.String]::Copy('%(ResolvedFileToPublish.SourcePath)').Contains('\accord.video.ffmpeg\'))" />
    </ItemGroup>
  </Target>
</Project>
