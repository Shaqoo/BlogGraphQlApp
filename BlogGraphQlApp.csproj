    <PackageReference Include="Accord.Video.FFMPEG.x64" Version="3.8.0" />
    <PackageReference Include="AppAny.HotChocolate.FluentValidation" Version="0.12.0" />
    <PackageReference Include="AutoMapper" Version="12.0.1" />
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" Version="12.0.1" />
    <PackageReference Include="codecracker.CSharp" Version="1.1.0" />
    <PackageReference Include="DotNetEnv" Version="3.2.0" />
    <PackageReference Include="FluentValidation.AspNetCore" Version="11.3.1" />
    <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.0" />
    <PackageReference Include="Google.GenAI" Version="0.6.0" />
    <PackageReference Include="HotChocolate.AspNetCore" Version="16.0.0-p.9.3" />
    <PackageReference Include="HotChocolate.AspNetCore.Authorization" Version="16.0.0-p.9.3" />
    <PackageReference Include="HotChocolate.Data.EntityFramework" Version="16.0.0-p.9.3" />
    <PackageReference Include="HotChocolate.Subscriptions" Version="16.0.0-p.9.3" />
    <PackageReference Include="HotChocolate.Subscriptions.InMemory" Version="16.0.0-p.9.3" />
    <PackageReference Include="HotChocolate.Types" Version="16.0.0-p.9.3" />
    <PackageReference Include="HotChocolate.Types.Scalars.Upload" Version="16.0.0-p.9.3" />
    <PackageReference Include="HotChocolate.Utilities.DependencyInjection" Version="16.0.0-p.9.3" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="8.0.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="8.0.0" />
    <PackageReference Include="Microsoft.ML" Version="4.0.3" />
    <PackageReference Include="Microsoft.ML.Recommender" Version="0.22.3" />
    <PackageReference Include="Mscc.GenerativeAI.Google" Version="2.9.3" />
    <PackageReference Include="OpenAI" Version="2.7.0" />
    <PackageReference Include="Pinecone.Client" Version="4.0.2" />
    <PackageReference Include="Pinecone.NET" Version="3.0.0" />
    <PackageReference Include="Polly" Version="8.6.5" />
    <PackageReference Include="Pomelo.EntityFrameworkCore.MySql" Version="8.0.0" />
    <PackageReference Include="Scrypt.NET" Version="1.3.0" />
    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux" Version="3.119.1" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="3.119.1" />
    <PackageReference Include="System.Drawing.Common" Version="10.0.0" />
    <PackageReference Include="System.Drawing.Primitives" Version="4.3.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.14.0" />
    <PackageReference Include="WebPush" Version="1.0.13" />
    <PackageReference Include="Xabe.FFmpeg" Version="6.0.2" />
    <PackageReference Include="Xabe.FFmpeg.Downloader" Version="6.0.2" />
  </ItemGroup>
  <Target Name="ExcludeConflictingNativeLibrariesFromPublish" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <!-- Accord.Video.FFMPEG(.x64) ships x86/x64 binaries with flat Link names, so
         `dotnet publish` fails with NETSDK1152 (duplicate publish output paths).
         The DLLs are not loaded by this app (the ffmpeg video pipeline uses the
         system ffmpeg binary via Xabe.FFmpeg), so exclude them from publish.
         `dotnet run`/build (which copies them to bin/) is unaffected. -->
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(ResolvedFileToPublish.SourcePath)').Contains('\accord.video.ffmpeg\'))" />
    </ItemGroup>
  </Target>
</Project>
